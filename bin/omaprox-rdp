#!/usr/bin/env bash
# Open a remote desktop, asking for an address and credentials once each and
# remembering both.
#
#   omaprox-rdp [--vmid N] <address> <label> [extra xfreerdp args...]
#
# Run with no terminal attached (which is how the bar launches it) this is
# silent when it already knows the address and the credentials: the desktop
# opens and no terminal ever appears. Only when something is missing, or a
# saved credential is refused, does it open a terminal to ask — and that
# terminal closes once the session is up, rather than sitting behind the
# desktop for the rest of it.
#
# `<address>` may be empty when `--vmid` is given, meaning the panel could not
# resolve a real one and this is being asked for it, once, to remember. The
# vmid is what the answer is filed under: Proxmox keeps vmids unique across
# the whole cluster, so it is enough on its own.
#
# Credentials live in the login keyring via libsecret, never in shell.json and
# never on the command line: FreeRDP is handed its arguments with /args-from
# reading a 0600 file, because /proc/<pid>/cmdline is world-readable and a /p:
# argument would show the password to every process on the machine.

set -uo pipefail

VMID=""
while [[ ${1:-} == --* ]]; do
  case $1 in
    --vmid) VMID=${2:-}; shift 2 ;;
    *) break ;;
  esac
done

ADDRESS=${1:-}
LABEL=${2:-${1:-}}
shift 2 2>/dev/null || true
EXTRA_ARGS=("$@")

if [[ -z $ADDRESS && -z $VMID ]]; then
  echo "usage: omaprox-rdp [--vmid N] <address> <label> [xfreerdp args...]" >&2
  exit 2
fi

ADDRESSES_FILE=${XDG_CONFIG_HOME:-$HOME/.config}/omaprox/addresses

# `vmid = address`, one per line — the same store bin/omaprox-ssh writes to and
# the same `key = value` shape as the token file.
lookup_address() {
  [[ -n $VMID && -f $ADDRESSES_FILE ]] || return 1
  local v
  v=$(sed -n "s/^[[:space:]]*${VMID}[[:space:]]*=[[:space:]]*//p" "$ADDRESSES_FILE" | tail -1)
  [[ -n $v ]] || return 1
  printf '%s' "$v"
}

store_address() {
  [[ -n $VMID ]] || return 0
  mkdir -p "$(dirname "$ADDRESSES_FILE")"
  local tmp
  tmp=$(mktemp "${ADDRESSES_FILE}.XXXXXX")
  { [[ -f $ADDRESSES_FILE ]] && grep -vE "^[[:space:]]*${VMID}[[:space:]]*=" "$ADDRESSES_FILE"
    printf '%s = %s\n' "$VMID" "$1"; } >"$tmp"
  mv "$tmp" "$ADDRESSES_FILE"
}

# Fill in from the store before anything else runs, so a vmid that has already
# been resolved once behaves exactly like an address the panel knew outright —
# including staying silent through the no-terminal path below.
if [[ -z $ADDRESS && -n $VMID ]]; then
  ADDRESS=$(lookup_address) || ADDRESS=""
fi

command -v xfreerdp3 >/dev/null 2>&1 || {
  echo "xfreerdp3 is not installed. Install the 'freerdp' package." >&2
  exit 127
}

HAVE_KEYRING=0
command -v secret-tool >/dev/null 2>&1 && HAVE_KEYRING=1

SCHEMA=()
LEGACY_SCHEMA=()

# The keyring key names the address, and the address can now be resolved after
# this script has already started — the terminal-mode prompt below fills in
# an ADDRESS that was empty when the script was invoked. SCHEMA cannot be a
# plain assignment made once near the top the way it used to be: computed
# before that prompt runs, it would freeze in the empty string, and every
# credential lookup and save for the rest of the run would silently miss.
# Called once, right after ADDRESS is settled for good, in every path that
# reaches the functions below.
#
# The plugin was first published as "proxmarchy", so a credential saved before
# the rename lives under that service name. Look both up; anything found in the
# old one is migrated over on success so the rename never orphans it.
set_schema() {
  SCHEMA=(service omaprox host "$ADDRESS")
  LEGACY_SCHEMA=(service proxmarchy host "$ADDRESS")
}

# `secret-tool search` splits its output: label and secret to stdout, the
# attributes to stderr. Discarding stderr loses the very fields being read;
# discarding stdout is what we want, since it keeps the password out of the pipe.
attribute() {
  ((HAVE_KEYRING)) || return 1
  local v
  v=$(secret-tool search "${SCHEMA[@]}" 2>&1 >/dev/null |
    sed -n "s/^ *attribute\.$1 = //p" | head -1)
  if [[ -n $v ]]; then printf '%s' "$v"; return 0; fi
  v=$(secret-tool search "${LEGACY_SCHEMA[@]}" 2>&1 >/dev/null |
    sed -n "s/^ *attribute\.$1 = //p" | head -1)
  [[ -n $v ]] && printf '%s' "$v"
  [[ -n $v ]]
}

lookup_password() {
  ((HAVE_KEYRING)) || return 1
  local p
  p=$(secret-tool lookup "${SCHEMA[@]}" 2>/dev/null)
  [[ -n $p ]] || p=$(secret-tool lookup "${LEGACY_SCHEMA[@]}" 2>/dev/null)
  [[ -n $p ]] || return 1
  printf '%s' "$p"
}

forget() {
  ((HAVE_KEYRING)) || return 0
  secret-tool clear "${SCHEMA[@]}" 2>/dev/null
  secret-tool clear "${LEGACY_SCHEMA[@]}" 2>/dev/null
  return 0
}

remember() {
  ((HAVE_KEYRING)) || return 0
  if printf '%s' "$3" | secret-tool store --label="Omaprox — $LABEL" \
      "${SCHEMA[@]}" username "$1" domain "$2" 2>/dev/null; then
    # One canonical copy under the current name; drop the pre-rename one if it
    # is still there.
    secret-tool clear "${LEGACY_SCHEMA[@]}" 2>/dev/null
    return 0
  fi
  return 1
}

# One argument per line, to be piped into /args-from:stdin.
emit_args() {
  printf '/v:%s\n' "$ADDRESS"
  printf '/u:%s\n' "$1"
  printf '/p:%s\n' "$2"
  [[ -n $3 ]] && printf '/d:%s\n' "$3"
  # Proxmox self-signs, and a workgroup Windows box signs its own RDP
  # certificate too, so verification would refuse every connection.
  printf '/cert:ignore\n'
  # NTLM only. Without this FreeRDP tries Kerberos first and, on a machine with
  # a stock /etc/krb5.conf whose default_realm is ATHENA.MIT.EDU, spends several
  # seconds failing against MIT's realm and fills the screen with errors that
  # have nothing to do with the login being attempted.
  printf '/auth-pkg-list:none,ntlm\n'
  printf '/dynamic-resolution\n+clipboard\n'
  local arg
  for arg in ${EXTRA_ARGS+"${EXTRA_ARGS[@]}"}; do
    [[ -n $arg ]] && printf '%s\n' "$arg"
  done
}

# Is the RDP port actually open? Answering this ourselves is what lets the watch
# below ask only one question — were the credentials refused. Inferring
# reachability from FreeRDP's log instead means enumerating everything a
# *successful* run can print, and getting that list wrong reports correct
# passwords as an unreachable host.
reachable() {
  local host=$ADDRESS port=3389
  case $ADDRESS in
    \[*\]:*) host=${ADDRESS%]:*}; host=${host#[}; port=${ADDRESS##*]:} ;;
    \[*\])   host=${ADDRESS#[}; host=${host%]} ;;
    *:*)     host=${ADDRESS%:*}; port=${ADDRESS##*:} ;;
  esac
  # The address is handed over as data (argv), never interpolated into the
  # command text: an address is a string that came from the cluster, and a
  # string that becomes shell code is a command execution bug.
  timeout 6 bash -c 'exec 3<>"$1"' _ "/dev/tcp/$host/$port" 2>/dev/null
}

REFUSED_RE="ERRCONNECT_(LOGON_FAILURE|ACCOUNT_[A-Z_]+|PASSWORD_[A-Z_]+|ACCESS_DENIED|AUTHENTICATION_FAILED)"

# Start the real session and watch it just long enough to tell whether the login
# was accepted. 0 = connected, 1 = refused, 2 = could not reach the host.
#
# There is deliberately no separate +auth-only probe. Authenticating, dropping
# the connection and immediately reconnecting makes Windows spend a minute or
# more letting the second one in — the desktop appears as a black window and
# hangs there. Connecting once and reading the outcome as it happens costs
# nothing and keeps the session instant.
#
# A rejection lands within a second or two, so a connection still healthy after
# the watch window is a connection that authenticated.
launch_watched() {
  reachable || return 2

  local tmpbase=${XDG_RUNTIME_DIR:-/tmp}
  local log args_file waited=0
  log=$(mktemp "$tmpbase/omaprox-rdp.log.XXXXXX") || return 2
  args_file=$(mktemp "$tmpbase/omaprox-rdp.args.XXXXXX") || { rm -f "$log"; return 2; }

  # The args — password included — never touch a process command line. They are
  # written to a 0600 file by the shell builtin (no child process, so nothing
  # shows up in /proc/<pid>/cmdline), FreeRDP reads them back from that file
  # through /args-from:stdin, and the name is unlinked the moment the descriptor
  # is open, so the secret spends as little time on disk as it takes FreeRDP to
  # consume it.
  emit_args "$1" "$2" "$3" >"$args_file"

  # setsid so the session survives this script and the terminal that ran it.
  setsid bash -c 'exec 0<"$1"; rm -f "$1"; xfreerdp3 /args-from:stdin >"$2" 2>&1' \
    _ "$args_file" "$log" &

  while ((waited < 24)); do
    if grep -qE "$REFUSED_RE" "$log" 2>/dev/null; then
      rm -f "$log" "$args_file"
      return 1
    fi
    sleep 0.25
    ((waited++))
  done

  # The log is dropped, not read further: the session owns the descriptor and
  # keeps writing to it for as long as it runs.
  rm -f "$log" "$args_file"
  return 0
}

ask() {
  local default_user=$1 default_domain=$2
  echo
  echo "  $LABEL  ·  $ADDRESS"
  echo
  if [[ -n $default_user ]]; then
    read -rp "  Username [$default_user]: " USERNAME
    USERNAME=${USERNAME:-$default_user}
  else
    read -rp "  Username: " USERNAME
  fi
  read -rsp "  Password: " PASSWORD
  echo
  # A local Windows account has no domain, which is the common case for a
  # workgroup PC, so blank is offered as the answer rather than demanded.
  read -rp "  Domain (blank for a local account) [${default_domain:-none}]: " DOMAIN
  DOMAIN=${DOMAIN:-$default_domain}
  echo
}

# ---------------------------------------------------------------- no terminal

# Launched from the bar: stdin is not a tty. Succeed silently if possible,
# otherwise re-launch inside a terminal that can ask — for the address, for
# credentials, or both, whichever this run is still missing.
if [[ ! -t 0 ]]; then
  if [[ -n $ADDRESS ]]; then
    set_schema
    PASSWORD=$(lookup_password) || PASSWORD=""
    if [[ -n $PASSWORD ]]; then
      USERNAME=$(attribute username) || USERNAME=""
      DOMAIN=$(attribute domain) || DOMAIN=""
      launch_watched "$USERNAME" "$PASSWORD" "$DOMAIN"
      case $? in
        0) remember "$USERNAME" "$DOMAIN" "$PASSWORD"; exit 0 ;; # connected, migrate any legacy entry
        2) ;;                 # host down — fall through so the terminal says so
        *) forget ;;          # refused — stop trying them and ask again
      esac
    fi
  fi

  vmid_args=()
  [[ -n $VMID ]] && vmid_args=(--vmid "$VMID")
  quoted=$(printf '%q ' "$0" ${vmid_args[@]+"${vmid_args[@]}"} "$ADDRESS" "$LABEL" \
    ${EXTRA_ARGS+"${EXTRA_ARGS[@]}"})
  exec setsid uwsm-app -- xdg-terminal-exec \
    --app-id=org.omarchy.terminal \
    --title="$LABEL  ·  sign in" \
    -e bash -c "$quoted"
fi

# ---------------------------------------------------------------- terminal

if [[ -z $ADDRESS ]]; then
  echo
  echo "  No known address for $LABEL (vmid $VMID)."
  echo "  Asked once, then remembered in $ADDRESSES_FILE."
  echo "  (Press F on the guest to be asked again.)"
  echo
  read -rp "  Address or hostname: " ADDRESS
  if [[ -z $ADDRESS ]]; then
    echo "  No address entered — nothing to connect to." >&2
    exit 2
  fi
  echo
  store_address "$ADDRESS"
fi

set_schema

((HAVE_KEYRING)) || echo "  secret-tool not found — credentials cannot be saved."

USERNAME=$(attribute username) || USERNAME=""
DOMAIN=$(attribute domain) || DOMAIN=""
PASSWORD=""

for attempt in 1 2 3; do
  ask "$USERNAME" "$DOMAIN"
  printf '  Connecting… '
  launch_watched "$USERNAME" "$PASSWORD" "$DOMAIN"
  case $? in
    0)
      echo "connected"
      remember "$USERNAME" "$DOMAIN" "$PASSWORD" \
        && echo "  Saved to the login keyring — you will not be asked again." \
        || echo "  Could not save to the keyring."
      exit 0
      ;;
    2)
      echo "cannot reach $ADDRESS"
      echo
      if [[ -n $VMID ]]; then
        echo "  Wrong address? Press F on this guest to be asked again, or set a"
        echo "  fixed one yourself in ~/.config/omarchy/shell.json:"
        echo '    { "id": "io.github.andressm415.omaprox", "addresses": { "'"$VMID"'": "<ip>" } }'
        echo
      fi
      read -rp "  press enter to close "
      exit 1
      ;;
    *)
      echo "rejected"
      [[ $attempt -lt 3 ]] && echo "  Wrong username or password — try again."
      ;;
  esac
done

echo
echo "  Giving up after 3 attempts."
read -rp "  press enter to close "
exit 1
