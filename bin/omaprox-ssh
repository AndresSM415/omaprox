#!/usr/bin/env bash
# Open an SSH console, setting up key authentication the first time so there is
# never a password prompt again.
#
#   omaprox-ssh [--vmid N --guess NAME] <user> <host> [command...]
#
# Deliberately does NOT store an SSH password anywhere. A stored password is a
# worse version of the thing SSH already solves properly: an authorized key is
# remembered by the server, survives password changes, can be revoked on its
# own, and is never transmitted. So the first connection offers to install your
# public key — one password, once — and every connection after that is silent.
#
# Answer no and it simply connects; you will be asked for a password each time,
# which is the same behaviour as before.
#
# `--vmid`/`--guess` are only ever passed for a guest's own address (the `pct
# enter`/node calls never pass them, and target the node directly — they never
# need any of this). An empty `<host>` alongside them means the panel could not
# resolve a real address and this is being asked for one, once, to remember.

set -uo pipefail

VMID=""
GUESS=""
while [[ ${1:-} == --* ]]; do
  case $1 in
    --vmid) VMID=${2:-}; shift 2 ;;
    --guess) GUESS=${2:-}; shift 2 ;;
    *) break ;;
  esac
done

USER_NAME=${1:-root}
HOST=${2:-}
shift 2 2>/dev/null || true
REMOTE_COMMAND=("$@")

ADDRESSES_FILE=${XDG_CONFIG_HOME:-$HOME/.config}/omaprox/addresses

# `vmid = address`, one per line, the same `key = value` shape as the token
# file. Proxmox enforces cluster-wide unique vmids, so the vmid alone is
# enough to key on — no need to also track which node or guest type.
lookup_address() {
  [[ -n $VMID && -f $ADDRESSES_FILE ]] || return 1
  local v
  v=$(sed -n "s/^[[:space:]]*${VMID}[[:space:]]*=[[:space:]]*//p" "$ADDRESSES_FILE" | tail -1)
  [[ -n $v ]] || return 1
  printf '%s' "$v"
}

store_address() {
  [[ -n $VMID ]] || return 0
  mkdir -p "$(dirname "$ADDRESSES_FILE")"
  local tmp
  tmp=$(mktemp "${ADDRESSES_FILE}.XXXXXX")
  { [[ -f $ADDRESSES_FILE ]] && grep -vE "^[[:space:]]*${VMID}[[:space:]]*=" "$ADDRESSES_FILE"
    printf '%s = %s\n' "$VMID" "$1"; } >"$tmp"
  mv "$tmp" "$ADDRESSES_FILE"
}

if [[ -z $HOST && -n $VMID ]]; then
  HOST=$(lookup_address) || HOST=""
  if [[ -z $HOST ]]; then
    echo
    echo "  No known address for ${GUESS:-this guest} (vmid $VMID)."
    echo "  Asked once, then remembered in $ADDRESSES_FILE."
    echo "  (Press F on the guest to be asked again.)"
    echo
    read -rp "  Address or hostname: " HOST
    if [[ -z $HOST ]]; then
      HOST=$GUESS
      echo "  Using '$HOST' — that may not resolve to anything."
    fi
    echo
    store_address "$HOST"
  fi
fi

if [[ -z $HOST ]]; then
  echo "usage: omaprox-ssh [--vmid N --guess NAME] <user> <host> [command...]" >&2
  exit 2
fi

TARGET="$USER_NAME@$HOST"

connect() {
  if ((${#REMOTE_COMMAND[@]})); then
    exec ssh -t "$TARGET" "${REMOTE_COMMAND[@]}"
  else
    exec ssh -t "$TARGET"
  fi
}

# Already trusted? Then nothing to arrange — go straight in. BatchMode makes ssh
# fail rather than fall back to asking, which is what makes this a test.
if ssh -o BatchMode=yes -o ConnectTimeout=5 -o StrictHostKeyChecking=accept-new \
       "$TARGET" true 2>/dev/null; then
  connect
fi

# No key auth. Is there a key to offer?
KEY=""
for candidate in "$HOME/.ssh/id_ed25519.pub" "$HOME/.ssh/id_rsa.pub" "$HOME/.ssh/id_ecdsa.pub"; do
  [[ -f $candidate ]] && { KEY=$candidate; break; }
done

if [[ -z $KEY ]] || ! command -v ssh-copy-id >/dev/null 2>&1; then
  connect
fi

cat <<EOF

  $TARGET asks for a password every time.

  Installing your public key makes that the last one:
      $KEY

  This appends the key to ~/.ssh/authorized_keys on $HOST. It grants this
  machine passwordless access to that account until you remove the key there.

EOF

read -rp "  Install it now? [y/N] " reply
echo

case ${reply,,} in
  y | yes)
    if ssh-copy-id -i "$KEY" "$TARGET"; then
      echo
      echo "  Installed. This is the last time you will be asked."
      echo
    else
      echo
      echo "  Could not install the key — connecting with a password instead."
      echo
    fi
    ;;
  *)
    echo "  Skipped. Connecting with a password."
    echo
    ;;
esac

connect
